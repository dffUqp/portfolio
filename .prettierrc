{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "auto",

  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "^react-dom$",
    "^react-dom(/.*)$",
    "",
    "^next$",
    "^next/(.*)$",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^app(/.*)?$",
    "",
    "^providers(/.*)?$",
    "",
    "^features(/.*)?$",
    "",
    "^components/templates(/.*)?$",
    "^components/molecules(/.*)?$",
    "^components/atoms(/.*)?$",
    "",
    "^utils(/.*)?$",
    "",
    "^[./]"
  ],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "importOrderTypeScriptVersion": "5.0.0"
}
